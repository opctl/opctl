{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "items": {
    "properties": {
      "name": {
        "type": "string"
      }
    },
    "oneOf": [
      {
        "description": "A test scenario for caller implementations",
        "properties": {
          "call": {
            "additionalProperties": false,
            "properties": {
              "authAddGithub": {
                "type": "boolean"
              },
              "expectOutputs": {
                "description": "Exact boxed public root completion outputs",
                "type": "object"
              },
              "opRef": {
                "type": "string"
              },
              "scope": {
                "$ref": "#/definitions/scope"
              },
              "expect": {
                "enum": [
                  "failure",
                  "success"
                ]
              },
              "createGo": {
                "type": "string",
                "description": "Scaffold a Go op with this name using opctl op create --go and run it with the in-repo SDK"
              },
              "cacheProof": {
                "type": "boolean",
                "description": "Run the parent-module Go fixture twice on one node and verify the executable cache"
              },
              "expectMessage": {
                "type": "string",
                "description": "Literal text required in the opctl run diagnostics"
              },
              "stubProof": {
                "type": "boolean",
                "description": "Verify typed op calls, warm caching, host stub refresh, and interface-triggered caller rebuilds"
              },
              "convert": {
                "type": "object",
                "additionalProperties": false,
                "description": "Copy a fixture root, convert its YAML op, and run the unchanged caller",
                "properties": {
                  "root": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string"
                  },
                  "expect": {
                    "enum": [
                      "written",
                      "refused"
                    ]
                  },
                  "expectMessages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "planOnly": {
                    "type": "boolean"
                  },
                  "snapshot": {
                    "type": "string"
                  }
                },
                "required": [
                  "root",
                  "op",
                  "expect"
                ]
              },
              "plan": {
                "type": "boolean",
                "description": "Inspect a secret-input Go op without running its calls; assert redaction and event privacy"
              }
            },
            "required": [
              "expect",
              "scope"
            ]
          }
        },
        "required": [
          "call"
        ]
      },
      {
        "description": "A test scenario for interpreter implementations",
        "properties": {
          "interpret": {
            "additionalProperties": false,
            "properties": {
              "scope": {
                "$ref": "#/definitions/scope"
              },
              "expect": {
                "enum": [
                  "failure",
                  "success"
                ]
              }
            }
          }
        },
        "required": [
          "interpret"
        ]
      },
      {
        "description": "A test scenario for validator implementations",
        "properties": {
          "validate": {
            "additionalProperties": false,
            "properties": {
              "expect": {
                "enum": [
                  "failure",
                  "success"
                ]
              }
            }
          }
        },
        "required": [
          "validate"
        ]
      }
    ]
  },
  "additionalProperties": false,
  "definitions": {
    "scope": {
      "items": {
        "additionalProperties": false,
        "patternProperties": {
          "[a-zA-Z]+": {}
        }
      }
    }
  }
}
